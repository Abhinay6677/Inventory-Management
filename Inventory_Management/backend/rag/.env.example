# Phase 2 environment variables
GOOGLE_API_KEY=your-gemini-api-key
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AI-Readiness-POC-07-P2
POC_ID=POC-07
PHASE=2
ASSOCIATE_ID=your-associate-id
RAG_CHROMA_DIR=./chroma_db
RAG_COLLECTION_NAME=inventory_manual

# Local Ollama runtime (Gemini alternative)
RAG_USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=smollm:latest
OLLAMA_MODEL_CANDIDATES=llama3.1,smollm:latest
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_DISCOVERY_TIMEOUT_SECONDS=5

# Debug response toggle for API server
RAG_DEBUG_RESPONSE=false
